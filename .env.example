# Local-first default. No cloud API key needed for Ollama.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=180
MAX_TOKENS=900
PUBLIC_BASE_URL=

# Optional public base URL for tracking links after deployment.
# Keep blank for local-only demos.
PUBLIC_BASE_URL=

# Optional AI image backgrounds. Calls to the image API may incur charges.
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
